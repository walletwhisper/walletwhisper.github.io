# Copy this file to .env and fill in your own values. .env is git-ignored; never commit it.
#
# Which AI service to use for categorizing transactions (optional).
# Only "gemini" is supported for now.
LLM_PROVIDER=gemini

# What is sent: cleaned merchant descriptions, amounts, account type and the bank category, only when you press
# "AI categorize". Never account numbers, balances, dates or names. Leave the key empty to stay fully offline.

# Your API key. Leave empty to run without AI categorization.
LLM_API_KEY=
