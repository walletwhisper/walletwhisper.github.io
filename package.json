{
  "name": "walletwhisper",
  "version": "1.0.0",
  "description": "Private, local-first household spending tracker for bank CSV statements",
  "type": "module",
  "scripts": {
    "start": "tsx run.js",
    "prestart": "npm run build:client",
    "postinstall": "npm --prefix client install",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks || true",
    "privacy-check": "node scripts/privacy-check.mjs --all"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
