{
  "name": "walletwhisper",
  "version": "1.0.0",
  "description": "Private household spending tracker for bank CSV statements. Runs entirely in your browser.",
  "type": "module",
  "scripts": {
    "start": "npm run build && npm --prefix client run preview -- --port 8000 --strictPort --open",
    "build": "npm --prefix client run build",
    "dev": "npm --prefix client run dev",
    "postinstall": "npm --prefix client install",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks || true",
    "privacy-check": "node scripts/privacy-check.mjs --all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@noble/hashes": "2.4.0",
    "csv-parse": "^7.0.3",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/sql.js": "1.4.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
